# =============================================================================
# SANTTORINI ERP — .env.example
# Bloco 4: Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA comite .env.local no git.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — Variáveis PÚBLICAS (prefixo NEXT_PUBLIC_)
# Expostas no browser. Não armazenar segredos aqui.
# -----------------------------------------------------------------------------

# URL pública da API do Supabase (Kong gateway ou domínio customizado)
# Dev local:  http://localhost:8000
# Produção:   https://santtorini.qarvon.com/api  (via reverse proxy EasyPanel)
#             OU https://<project-ref>.supabase.co (Supabase hosted)
SYSTEM_USER_ID=your-system-user-uuid-here

NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Chave anônima — acesso público, respeitará RLS policies
# Obtenha em: Supabase Dashboard > Project Settings > API > anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# SUPABASE — Variáveis PRIVADAS (servidor apenas, sem prefixo NEXT_PUBLIC_)
# Nunca importar em componentes client. Usar apenas em API Routes e Server Actions.
# -----------------------------------------------------------------------------

# Service Role Key — bypassa RLS, acesso total. Usar APENAS no servidor.
# Obtenha em: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret — para validação de tokens no middleware (se necessário)
# Deve coincidir com JWT_SECRET do Supabase stack
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------

# URL canônica do app (usada em redirects OAuth e emails)
# Dev: http://localhost:3000
# Produção: https://santtorini.qarvon.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret para proteger endpoints de cron jobs (/api/jobs/*)
# Gere com: openssl rand -hex 32
CRON_SECRET=replace-with-a-random-secret-32chars

# Empresa para a qual /api/alerts/daily (cron de alerta diário via WhatsApp)
# gera os alertas. Solução operacional temporária — só existe uma empresa e
# um destinatário global hoje. Quando existir uma segunda empresa com
# alertas próprios, isso vira configuração por empresa.
ALERT_COMPANY_ID=1

# URL do webhook n8n disparado após venda confirmada (fluxo v1 — não alterar)
# Deixe vazio para desativar o envio
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/pos-venda

# Webhook v2 — novo fluxo com contexto dinâmico do ERP
# Deixe vazio para desativar; não interfere com N8N_WEBHOOK_URL
N8N_WEBHOOK_URL_V2=https://seu-n8n.com/webhook/pos-venda-v2

# Secret compartilhado entre ERP e N8N para /api/automations/post-sale/*
# Gere com: openssl rand -hex 32
N8N_AUTOMATION_SECRET=replace-with-random-secret-32chars

# Secret dedicado para /api/automations/crm/* (ingestão inbound de mensagem
# e sincronização de status) — direção N8N → ERP.
# Isolado de N8N_AUTOMATION_SECRET por decisão explícita — raio de exposição
# separado entre automação de pós-venda e automação de CRM.
# Gere com: openssl rand -hex 32
N8N_CRM_SECRET=replace-with-random-secret-32chars

# Envio outbound (Entrega 6) — direção ERP → N8N (oposto de N8N_CRM_SECRET).
# ERP chama este webhook de forma síncrona; N8N fala com o Evolution e
# devolve o resultado (provider_message_id) na mesma resposta HTTP.
N8N_CRM_OUTBOUND_WEBHOOK_URL=https://seu-n8n.com/webhook/crm-outbound
# Gere com: openssl rand -hex 32
N8N_CRM_OUTBOUND_SECRET=replace-with-random-secret-32chars

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Web Push / VAPID)
# -----------------------------------------------------------------------------

# Chave pública VAPID — exposta no frontend (usada pelo navegador para assinar a assinatura push)
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Chave privada VAPID — apenas servidor, NUNCA expor no cliente
VAPID_PRIVATE_KEY=your-vapid-private-key-here

# Identificador do emissor (obrigatório pela spec) — mailto: ou URL do domínio
VAPID_SUBJECT=mailto:ti@santtorini.com.br

# -----------------------------------------------------------------------------
# NUVEMSHOP / TIENDANUBE
# -----------------------------------------------------------------------------

# Access token gerado no fluxo OAuth do app (necessário para chamadas à API)
NUVEMSHOP_ACCESS_TOKEN=your-nuvemshop-access-token-here

# ID da loja na Nuvemshop (aparece na URL do painel ou no payload OAuth)
NUVEMSHOP_STORE_ID=your-nuvemshop-store-id-here

# UUID do usuário sistema no ERP que representa pedidos da Nuvemshop
NUVEMSHOP_SYSTEM_USER_ID=your-system-user-uuid-here

# User-Agent enviado nas chamadas à API da Nuvemshop
NUVEMSHOP_APP_AGENT=erp-nuvemshop-integration (no-reply@local)

# Client Secret do app OAuth (Parceiros Nuvemshop > seu app > Client Secret).
# Usado para validar a assinatura HMAC-SHA256 dos webhooks recebidos.
# OBRIGATÓRIO em produção. Se ausente, o webhook retorna 500 e rejeita todos os requests.
NUVEMSHOP_CLIENT_SECRET=your-nuvemshop-client-secret-here

# Desabilita a validação HMAC para testes locais sem secret configurado.
# NUNCA defina como true em produção. Ausente ou false = validação ativa.
# NUVEMSHOP_SKIP_WEBHOOK_HMAC=true

# -----------------------------------------------------------------------------
# NOTAS DE CONFIGURAÇÃO PARA PRODUÇÃO
# -----------------------------------------------------------------------------
# 1. NEXT_PUBLIC_SUPABASE_URL em produção:
#    - Se Supabase self-hosted com subdomínio próprio:
#      NEXT_PUBLIC_SUPABASE_URL=https://supabase.santtorini.qarvon.com
#    - Se usando Supabase Cloud:
#      NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
#
# 2. No EasyPanel, configure as env vars acima no painel de variáveis do serviço.
#    Nunca crie .env.local no container de produção.
#
# 3. SUPABASE_SERVICE_ROLE_KEY nunca aparece no bundle do client.
#    O Next.js garante isso — variáveis sem NEXT_PUBLIC_ só existem no servidor.
#
# 4. Para o stack Supabase self-hosted, API_EXTERNAL_URL deve apontar para
#    o mesmo valor de NEXT_PUBLIC_SUPABASE_URL configurado aqui.
